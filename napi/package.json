{
	"name": "@yojo-art/media-proxy-napi",
	"version": "1.0.0",
	"description": "Media proxy image processor (napi) for misskey/cherrypick",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yojo-art/media-proxy-rs.git",
		"directory": "napi"
	},
	"engines": {
		"node": ">= 18"
	},
	"main": "index.js",
	"types": "index.d.ts",
	"files": [
		"index.js",
		"index.d.ts"
	],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"napi": {
		"binaryName": "media-proxy-napi",
		"targets": [
			"x86_64-unknown-linux-gnu",
			"aarch64-unknown-linux-gnu",
			"aarch64-apple-darwin",
			"x86_64-pc-windows-msvc"
		]
	},
	"scripts": {
		"build": "napi build --platform --release",
		"build:debug": "napi build --platform",
		"test": "node --test test/*.mjs"
	},
	"devDependencies": {
		"@napi-rs/cli": "^3.10.5"
	}
}
